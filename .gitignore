# Python
venv/
__pycache__/
*.pyc

# DuckDB warehouse file
*.duckdb
*.duckdb.wal

# Raw / staging data (regenerated by ingestion scripts, too large for git)
data/raw/*
!data/raw/.gitkeep
data/staging/*
!data/staging/.gitkeep

# dbt artifacts
target/
dbt_packages/
logs/
.user.yml

# Airflow
airflow.db
airflow.cfg
airflow-webserver.pid

# Secrets / local env
.env
# ngoại lệ: orchestration/.env chỉ chứa AIRFLOW_UID, không phải secret thật
!orchestration/.env
.claude/plan/next-steps.md

# Great Expectations: chỉ ignore output sinh ra, giữ lại expectations/checkpoints
# (source, tương tự schema.yml của dbt) -- đúng quy ước GX tự sinh khi scaffold
quality/gx/uncommitted/
